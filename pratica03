print("--- Exercício 14 — Compra de produto ---")
prod_nome = input("Nome do produto: ")
prod_preco = float(input("Preço unitário: R$ "))
prod_qtd = int(input("Quantidade: "))
total_prod = prod_preco * prod_qtd
print("\n--- RESUMO DA COMPRA ---")
print(f"Produto: {prod_nome}")
print(f"Preço unitário: R$ {prod_preco:.2f}")
print(f"Quantidade: {prod_qtd}")
print(f"Total: R$ {total_prod:.2f}\n")

print("--- Exercício 15 — Pagamento ---")
func_nome = input("Nome do funcionário: ")
