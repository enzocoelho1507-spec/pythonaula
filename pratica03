print("--- Exercício 13 — Média do aluno ---")
aluno = input("Nome do aluno: ")
n1 = float(input("Nota 1: "))
n2 = float(input("Nota 2: "))
media_aluno = (n1 + n2) / 2
print("\n--- BOLETIM ---")
