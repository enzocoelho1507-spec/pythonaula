func_bonus = float(input("Bônus: R$ "))
total_func = func_salario + func_bonus
print("\n--- CONTRACHEQUE ---")
print(f"Funcionário: {func_nome}")
print(f"Salário base: R$ {func_salario:.2f}")
print(f"Bônus: R$ {func_bonus:.2f}")
print(f"Total a receber: R$ {total_func:.2f}\n")

print("--- Exercício 16 — Desconto ---")
preco_orig = float(input("Preço original: R$ "))
val_desc = float(input("Valor do desconto em reais: R$ "))
preco_final = preco_orig - val_desc
print("\n--- RESUMO DO DESCONTO ---")
print(f"Preço original: R$ {preco_orig:.2f}")
print(f"Desconto: R$ {val_desc:.2f}")
print(f"Preço final: R$ {preco_final:.2f}")
print("\n" + "="*40 + "\n")


